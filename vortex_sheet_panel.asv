clear;
close all;
xmin = -2.5;
xmax = 2.5;
ymin = -2;
ymax = 2;
ny = 41;
nx = 51;
del = 1.5;
gamma_a = 0.2;
gamma_b = 0.4;
nv=100;
yc=0;
psi_approx = zeros(nx, ny);
for i = 1:nx
    for j = 1:ny
        xm(i,j) = xmin + (i-1)*(xmax-xmin)/(nx-1);
        ym(i,j) = ymin + (j-1)*(xmax-xmin)/(ny-1);
        infa(i,j) = refpainf(del, xm(i,j), ym(i,j))(1);
        infb(i)
        psi_analy(i,j) = gamma_a*infa(i,j) + gamma_b *infb(i,j);
        
    end
end
for n = 1:nv
    xc = (2*n-1)*del/nv;
    gamma = gamma_a*(del-xc)/del + gamma_b*xc/del;
    for i = 1:nx
        for j = 1:ny
            psi_approx(i,j) = psi_approx(i,j) + psipv(xc, yc, gamma, xm(i,j), ym(i,j));
        end 
    end
end


c = -0.5:0.05:0.5;





contour(xm,ym,infa,c);
xlabel('x');
ylabel('y');
title('Contour plot of influence coefficient a');

figure(2);
contour(xm,ym,infb,c);
xlabel('x');
ylabel('y');
title('Contour plot of influence coefficient b');

figure(3);
contour(xm,ym,psi_analy,c);
xlabel('x');
ylabel('y');
title('Contour plot of the analytical solution');

figure(4);
contour(xm,ym,psi_approx,c);
xlabel('x');
ylabel('y');
title('Contour plot of discretised approximation');